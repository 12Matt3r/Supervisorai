{
  "name": "data.cleaner",
  "version": "2.0.0",
  "kind": "shell",
  "description": "Cleans a dataset: dedupes, normalizes, imputes nulls, fixes encodings, removes PII. Emits a recipe (great_expectations-style).",
  "entry": "scripts/clean_dataset.py",
  "writes": [
    "cleaned.parquet",
    "recipe.json",
    "data-clean-report.md"
  ],
  "reads": [
    "{{input.path}}"
  ],
  "input_schema": {
    "type": "object",
    "required": [
      "path"
    ],
    "properties": {
      "path": {
        "type": "string"
      },
      "dedup_keys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "impute_strategy": {
        "enum": [
          "mean",
          "median",
          "mode",
          "drop",
          "llm"
        ],
        "default": "median"
      },
      "pii_strategy": {
        "enum": [
          "redact",
          "hash",
          "drop"
        ],
        "default": "redact"
      },
      "max_rows": {
        "type": "integer"
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "output_path",
      "rows_in",
      "rows_out"
    ],
    "properties": {
      "output_path": {
        "type": "string"
      },
      "rows_in": {
        "type": "integer"
      },
      "rows_out": {
        "type": "integer"
      },
      "recipe": {
        "type": "string"
      },
      "pii_removed_count": {
        "type": "integer"
      }
    }
  },
  "resources": {
    "cpu": "high",
    "mem": "8Gi",
    "net": "offline"
  },
  "retry_policy": {
    "max_attempts": 1,
    "backoff": "none"
  },
  "quality": {
    "min_score": 0.75,
    "max_latency_s": 1800,
    "max_cost_usd": 0.1,
    "must_have": [
      "output_path",
      "rows_in",
      "rows_out",
      "recipe"
    ],
    "must_not": []
  },
  "invariants_compliant": [
    "I1",
    "I2",
    "I3",
    "I4",
    "I5",
    "I6",
    "I7",
    "I8"
  ],
  "invariants_provisional": [],
  "composes_with": [
    "data.synthesizer"
  ],
  "versioning": {
    "strategy": "immutable",
    "eol": null
  },
  "deprecated": false,
  "deprecation_message": null
}
