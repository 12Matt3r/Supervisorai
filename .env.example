# SupervisorAI — GMI Cloud / MiniMax-M3 configuration
# Copy to `.env` and fill in your key:  cp .env.example .env
#
# Get a GMI serving key from the GMI Cloud console. NEVER commit your real key.

GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
SUPERVISOR_MODEL=MiniMaxAI/MiniMax-M3

# Optional: soft cap on cumulative tokens across a run (leave blank for no cap).
# SUPERVISOR_TOKEN_BUDGET=200000
