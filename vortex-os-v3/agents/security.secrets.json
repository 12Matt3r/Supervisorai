{
  "name": "security.secrets",
  "version": "2.0.0",
  "kind": "shell",
  "description": "Secret detection across source and history. Uses gitleaks/trufflehog with entropy heuristics; redacts and reports; quarantines leaks.",
  "entry": "scripts/run_secret_scan.sh",
  "writes": [
    "secrets.json",
    "reports/secrets.md"
  ],
  "reads": [
    "./**",
    ".git/**"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "scan_history": {
        "type": "boolean",
        "default": true
      },
      "deep_entropy": {
        "type": "boolean",
        "default": true
      },
      "fail_on_crit": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "findings"
    ],
    "properties": {
      "findings": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "redacted_logs": {
        "type": "string"
      },
      "rotated_keys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "resources": {
    "cpu": "med",
    "mem": "2Gi",
    "net": "offline"
  },
  "retry_policy": {
    "max_attempts": 1,
    "backoff": "none"
  },
  "quality": {
    "min_score": 0.95,
    "max_latency_s": 300,
    "max_cost_usd": 0,
    "must_have": [
      "findings"
    ],
    "must_not": [
      "AKIA",
      "-----BEGIN",
      "ghp_"
    ]
  },
  "invariants_compliant": [
    "I1",
    "I2",
    "I3",
    "I4",
    "I5",
    "I6",
    "I7",
    "I8"
  ],
  "invariants_provisional": [],
  "versioning": {
    "strategy": "immutable",
    "eol": null
  },
  "deprecated": false,
  "deprecation_message": null
}
