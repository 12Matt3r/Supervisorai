{
  "name": "coder.typescript",
  "version": "2.0.0",
  "kind": "subplan",
  "description": "Implements TypeScript / JavaScript code: React/Node/Vue/Nest components, hooks, services, with typings, ESLint and Vitest tests.",
  "entry": "templates/coder.json",
  "input_schema": {
    "type": "object",
    "required": [
      "task_description",
      "target_files"
    ],
    "properties": {
      "task_description": {
        "type": "string"
      },
      "target_files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "framework": {
        "enum": [
          "react",
          "node",
          "vue",
          "nest",
          "next",
          "vanilla"
        ],
        "default": "react"
      },
      "language": {
        "enum": [
          "typescript",
          "javascript"
        ],
        "default": "typescript"
      },
      "strict": {
        "type": "boolean",
        "default": true
      }
    }
  },
  "output_schema": {
    "type": "object",
    "required": [
      "diff",
      "summary"
    ],
    "properties": {
      "diff": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      }
    }
  },
  "writes": [
    "{{target_files}}",
    "patch.diff"
  ],
  "reads": [
    "{{target_files}}",
    "package.json",
    "tsconfig.json"
  ],
  "resources": {
    "cpu": "med",
    "mem": "3Gi",
    "net": "offline"
  },
  "retry_policy": {
    "max_attempts": 2,
    "backoff": "exponential",
    "on": [
      "timeout"
    ]
  },
  "quality": {
    "min_score": 0.7,
    "max_latency_s": 1500,
    "max_cost_usd": 1.2,
    "must_have": [
      "diff",
      "summary"
    ],
    "must_not": [
      "any",
      ": any",
      "console.log",
      "// TODO"
    ]
  },
  "invariants_compliant": [
    "I1",
    "I2",
    "I3",
    "I4",
    "I5",
    "I6",
    "I7",
    "I8"
  ],
  "invariants_provisional": [],
  "composes_with": [
    "tester.mutation"
  ],
  "versioning": {
    "strategy": "immutable",
    "eol": null
  },
  "deprecated": false,
  "deprecation_message": null
}
